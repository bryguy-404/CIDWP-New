---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import ReviewNote from "./ReviewNote.astro";
const { reviewMode = false } = Astro.props;
const mapUrl = "https://www.google.com/maps?q=" + encodeURIComponent(site.name + " " + site.address + " " + site.city) + "&output=embed";
---
<section class="office-section" id="contact" aria-labelledby="office-title" data-section="office">
  <div class="shell office-grid"><div><h2 id="office-title">Come See Us<br /><strong>In Westport.</strong></h2><address><Icon name="pin" /><span>{site.address}<br />{site.city}</span></address><a class="text-link" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">Get Directions <Icon /></a><a class="office-phone" href={site.phoneUrl}><Icon name="phone" />{site.phone}</a><div class="office-hours"><span>Office Hours</span><p>{site.hours}</p><p class="hours-note">Please call for appointment availability.</p></div><ReviewNote show={reviewMode}>Please confirm Friday hours. The homepage and Smile Club list Monday–Thursday; the contact page also lists Friday.</ReviewNote></div><div class="office-map"><div class="map-stage"><div class="map-fallback" aria-hidden="true"><Icon name="pin" /><strong>Find Us In Westport</strong><span>{site.address}<br />{site.city}</span></div><iframe title="Map to Cosmetic & Implant Dentistry Westport, 638 W 39th St, Kansas City" src={mapUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div><a class="map-open" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">Open In Google Maps <Icon /></a></div></div>
</section>
