---
import { Image } from "astro:assets";
import { expertise } from "../lib/homepage";
---
<section class="expertise-section" id="expertise" aria-labelledby="expertise-title" data-section="expertise">
  <div class="expertise-intro">
    <h2 id="expertise-title">Find The Care<br /><strong>You’re Looking For.</strong></h2>
  </div>
  <div class="expertise-grid">
    {expertise.map((service, index) => (
      <a class="expertise-tile" href={service.href}>
        <Image
          src={service.image}
          alt=""
          widths={[480, 800, 1200]}
          sizes={index === expertise.length - 1
            ? "(max-width: 800px) 100vw, 33.33vw"
            : "(max-width: 500px) 100vw, (max-width: 800px) 50vw, 33.33vw"}
          loading="lazy"
          class="expertise-photo"
          style={{ objectPosition: service.position }}
        />
        <span class="expertise-label">{service.label}</span>
      </a>
    ))}
  </div>
</section>
