---
const categories = [
  {
    kicker: "Maintain",
    services: ["Preventive dentistry", "Hygiene visits", "Fillings", "Mouth guards"],
  },
  {
    kicker: "Transform",
    services: ["Veneers", "Teeth whitening", "Clear braces", "Cosmetic dentistry"],
  },
  {
    kicker: "Restore",
    services: ["Dental implants", "Crowns and bridges", "Root canals", "Full-mouth restoration"],
  },
  {
    kicker: "Support",
    services: ["Sedation dentistry", "Extractions", "TMJ/TMD care", "Sleep-apnea solutions"],
  },
];
---

<section id="services" class="bg-navy py-20 text-white lg:py-28">
  <div class="shell">
    <div class="grid gap-8 border-b border-white/15 pb-12 lg:grid-cols-[1.1fr_.9fr] lg:items-end">
      <h2 class="text-5xl font-light leading-none tracking-[-.04em] sm:text-7xl">
        Care without<br /><span class="font-extrabold text-aqua">the runaround.</span>
      </h2>
      <p class="max-w-xl text-base leading-7 text-white/70 lg:justify-self-end">
        A broad range of services helps patients address everyday health, comfort, appearance, and
        more complex restorative needs in one welcoming practice.
      </p>
    </div>

    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((category) => (
          <div>
            <p class="text-xs font-bold uppercase tracking-[.2em] text-aqua">{category.kicker}</p>
            <ul class="mt-5 space-y-3 text-sm text-white/80">
              {category.services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
