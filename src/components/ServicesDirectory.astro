---
import { serviceLinks, site } from "../lib/site";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
const categories = [
  { id: "general-care", number: "01", title: "Keep your smile healthy.", label: "General dentistry", body: "Checkups, cleanings, fillings, and mouth guards. Thoughtful everyday care for every member of the family.", links: [{ label: "General dentistry", href: serviceLinks.general }] },
  { id: "cosmetic-care", number: "02", title: "Make it feel more like you.", label: "Cosmetic dentistry", body: "Veneers, professional whitening, and clear braces. Explore the details that can make a difference to your smile.", links: [{ label: "Veneers", href: serviceLinks.veneers }, { label: "Teeth whitening", href: serviceLinks.whitening }] },
  { id: "restorative-care", number: "03", title: "Get back to smiling.", label: "Restorative dentistry", body: "Dental implants, crowns, bridges, root canals, and full-mouth restoration. A considered approach to rebuilding health and function.", links: [{ label: "Dental implants", href: serviceLinks.implants }, { label: "Full-mouth restoration", href: serviceLinks.restoration }] },
  { id: "supportive-care", number: "04", title: "Find the support you need.", label: "Comfort & additional care", body: "Sedation options, extractions, emergency visits, TMJ/TMD care, and sleep-apnea solutions. Start with a conversation about your concerns.", links: [{ label: "Sedation options", href: serviceLinks.sedation }, { label: "Emergency dentistry", href: serviceLinks.emergency }] },
];
---
<section id="services" class="section-space services-section" aria-labelledby="services-title">
  <div class="shell services-grid">
    <div class="services-intro">
      <p class="eyebrow">03 / Care for every chapter</p>
      <SectionHeading id="services-title" lines={["Your smile.", "Your kind", "of care."]} />
      <p class="body-copy">From the routine to the life-changing, find a thoughtful next step right here in Westport.</p>
      <a href={site.phoneUrl} class="text-link">Not sure where to start? <Icon /></a>
    </div>
    <div class="service-list">
      {categories.map((category) => (
        <article id={category.id} class="service-row" data-reveal>
          <span class="service-number">{category.number}</span>
          <div>
            <p class="small-label">{category.label}</p>
            <h3>{category.title}</h3>
            <p>{category.body}</p>
            <div class="service-links">{category.links.map((link) => <a href={link.href}>{link.label}<Icon /></a>)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
