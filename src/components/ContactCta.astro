---
import { site } from "../lib/site";
---

<section id="contact" class="bg-aqua">
  <div class="shell grid gap-8 py-16 lg:grid-cols-[1fr_auto] lg:items-center">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[.22em]">{site.locality}</p>
      <h2 class="mt-3 text-4xl font-extrabold tracking-[-.04em] sm:text-6xl">
        Ready when you are.
      </h2>
      <p class="mt-4 max-w-2xl text-navy/75">
        Reach out about routine care, an urgent concern, or the next step in a cosmetic or
        restorative plan.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={site.contactUrl}
        class="bg-navy px-7 py-4 text-center text-sm font-extrabold text-white">Contact Us</a
      >
      <a
        href="#services"
        class="border border-navy px-7 py-4 text-center text-sm font-extrabold">Explore Services</a
      >
    </div>
  </div>
</section>
