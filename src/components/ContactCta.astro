---
import { Image } from "astro:assets";
import { photos } from "../lib/homepage";
import ActionPair from "./ActionPair.astro";
interface Props { final?: boolean }
const { final = false } = Astro.props;
const titleId = final ? "final-cta-title" : "schedule-title";
---
<section class:list={["contact-cta", { "final-cta": final }]} aria-labelledby={titleId} data-section={final ? "final-cta" : "schedule"}>
  {!final && <Image src={photos.office} alt="" aria-hidden="true" widths={[750, 1400, 2000]} sizes="100vw" loading="lazy" class="cta-backdrop" />}
  <div class="shell cta-content"><div><h2 id={titleId}>{final ? <>we’re ready<br /><strong>when you are.</strong></> : <>let’s plan<br /><strong>your first visit.</strong></>}</h2>{final && <p>Find a time that works for you and get to know our Westport team.</p>}</div><ActionPair /></div>
</section>
