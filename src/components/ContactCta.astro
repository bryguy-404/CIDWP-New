---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="shell contact-grid">
    <div><p class="eyebrow">Your next chapter starts here</p><SectionHeading id="contact-title" lines={["Let’s give you", "a reason to smile."]} /><p class="contact-description">A familiar face for everyday care.<br />A thoughtful partner for what comes next.</p></div>
    <div class="contact-actions"><a href={site.bookingUrl} class="button button-navy">Book a visit <Icon /></a><span>Prefer a conversation?</span><a class="contact-phone" href={site.phoneUrl}>{site.phone}<Icon name="phone" /></a></div>
  </div>
</section>
