---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="shell contact-grid">
    <div><p class="eyebrow">Visit us in Westport</p><SectionHeading id="contact-title" lines={["Let’s plan", "your first visit."]} /><p class="contact-description">Get to know a team you can turn to for everyday care and whatever comes next.</p></div>
    <div class="contact-actions"><a href={site.bookingUrl} class="button button-navy">Book a visit <Icon /></a><span>Prefer a conversation?</span><a class="contact-phone" href={site.phoneUrl}>{site.phone}<Icon name="phone" /></a></div>
  </div>
</section>
