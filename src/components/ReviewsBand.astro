---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---
<section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
  <div class="shell reviews-grid">
    <div><p class="eyebrow">From the people who know us</p><SectionHeading id="reviews-title" lines={["Their smiles.", "Their stories."]} /></div>
    <div class="reviews-copy"><p>Choosing a dentist is personal. Hear directly from patients about their experiences with our Westport team.</p><a href={site.reviewsUrl} target="_blank" rel="noopener noreferrer" class="text-link"><span class="google-letter" aria-hidden="true">G</span>Read our Google reviews <Icon /></a></div>
  </div>
</section>
