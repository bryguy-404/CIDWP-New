---
import type { PatientReview } from "../lib/reviews";
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import ReviewNote from "./ReviewNote.astro";
interface Props {
  reviews: PatientReview[];
  reviewMode?: boolean;
  id?: string;
}
const { reviews, reviewMode = false, id = "reviews" } = Astro.props;
const slidesId = `${id}-slides`;
const titleId = `${id}-title`;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
});
const slides = reviews.map(review => {
  const date = review.date ? new Date(review.date) : null;
  const validDate = date && !Number.isNaN(date.getTime()) ? date : null;
  return {
    ...review,
    dateLabel: validDate ? dateFormatter.format(validDate) : null,
    dateTime: validDate?.toISOString(),
  };
});
---
<section class="reviews-section" id={id} aria-labelledby={titleId} data-section="reviews" data-review-state="fallback" data-reviews-endpoint="/api/google-reviews">
  <div class:list={["shell reviews-grid", { "reviews-empty": !slides.length }]}>
    <div class="review-carousel" role="region" aria-roledescription="carousel" aria-label="Patient reviews" tabindex="0" data-carousel hidden={!slides.length}>
      <div class="review-slides" id={slidesId}>{slides.map((review, index) => (
        <article class="review-slide" data-slide role="group" aria-roledescription="slide" aria-label={(index + 1) + " of " + slides.length} aria-hidden={index !== 0} inert={index !== 0}>
          <Icon name="quote" />
          <p class="review-rating" role="img" aria-label={`${review.rating} out of 5 stars`}><span aria-hidden="true">{"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)}</span></p>
          <blockquote cite={review.sourceUrl}>{review.text}</blockquote>
          <p class="review-author">{review.name}</p>
          <div class="review-meta">
            <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer" class="review-source" aria-label={`Read ${review.name}’s full review on Google`}>{review.isExcerpt ? "Google Review Excerpt" : "Google Review"} <Icon /></a>
            {review.dateLabel && <time datetime={review.dateTime}>{review.dateLabel}</time>}
          </div>
        </article>
      ))}</div>
      <div class="carousel-controls" hidden>
        <button type="button" data-previous aria-label="Previous review" aria-controls={slidesId}><Icon class="arrow-back" /></button>
        <span data-counter aria-live="polite" aria-atomic="true">1 / {slides.length}</span>
        <button type="button" data-next aria-label="Next review" aria-controls={slidesId}><Icon /></button>
      </div>
      <div class="review-attribution" data-live-attribution hidden>
        <img src="/google-maps-attribution.svg" alt="Google Maps" class="google-maps-logo" width="98" height="18" loading="lazy" />
        <p>Five-star written reviews from Google’s selection, newest first.</p>
        <p data-provider-attributions hidden></p>
      </div>
      <p class="review-selection-note" data-fallback-note>Selected five-star Google review excerpts.</p>
    </div>
    <div class="reviews-intro"><h2 id={titleId}>Hear From<br /><strong>Our Patients.</strong></h2><p>Choosing a dentist is personal. Read what patients have shared about their experience with our Westport team.</p><a href={site.reviewsUrl} target="_blank" rel="noopener noreferrer" class="text-link">Read Our Google Reviews <Icon /></a></div>
  </div>
  <template data-live-review>
    <article class="review-slide review-slide-live" data-slide role="group" aria-roledescription="slide">
      <Icon name="quote" />
      <p class="review-rating" role="img"><span aria-hidden="true"></span></p>
      <blockquote><span class="review-text is-collapsed" data-review-text dir="auto"></span></blockquote>
      <button class="review-expand" type="button" data-expand aria-expanded="false" hidden>Read More</button>
      <div class="review-author-row">
        <img data-avatar class="review-avatar" width="40" height="40" alt="" loading="lazy" referrerpolicy="no-referrer" hidden />
        <p class="review-author" data-author></p>
      </div>
      <div class="review-meta">
        <a target="_blank" rel="noopener noreferrer" class="review-source" data-source>Read On Google Maps <Icon /></a>
        <time hidden></time>
      </div>
    </article>
  </template>
  <div class="shell"><ReviewNote show={reviewMode}>Reviews load through the Cloudflare Pages function when this section approaches the viewport. Google supplies up to five reviews by relevance; the site keeps only five-star written reviews and orders them by publication date, newest first, with undated reviews last. This can show fewer than five reviews and does not select from the full review history. The original four manually checked five-star excerpts remain as a fallback if the API is unavailable or returns no matching reviews. Dates, author profiles, and avatars come from the API when available.</ReviewNote></div>
</section>
<script>
  import { initializeReviewCarousels } from "../scripts/reviews";
  initializeReviewCarousels();
</script>
