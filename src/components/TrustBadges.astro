---
import { Image } from "astro:assets";
import { trustBadges } from "../lib/homepage";
import ReviewNote from "./ReviewNote.astro";
const { reviewMode = false } = Astro.props;
---
{(trustBadges.length > 0 || reviewMode) && <section class="trust-section" id="credentials" aria-label="Practice associations and awards" data-section="trust"><div class="shell"><div class="trust-grid">{trustBadges.length ? trustBadges.map(badge => badge.href ? <a href={badge.href} target="_blank" rel="noopener noreferrer"><Image src={badge.image} alt={badge.name} width={160} loading="lazy" /></a> : <Image src={badge.image} alt={badge.name} width={160} loading="lazy" />) : Array.from({length: 5}, () => <div class="asset-placeholder badge-placeholder"><span class="placeholder-seal" aria-hidden="true"></span><small>Approved Badge</small></div>)}</div><ReviewNote show={reviewMode && !trustBadges.length}>Space for CIDWP’s confirmed associations and awards. Approved names and logo files are needed.</ReviewNote></div></section>}
