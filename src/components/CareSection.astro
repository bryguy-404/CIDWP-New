---
import { Image } from "astro:assets";
import { photos } from "../lib/homepage";
import Icon from "./Icon.astro";
const details = ["care for every member of the family", "general, cosmetic, and restorative dentistry", "time to understand your options and ask questions", "sedation options for patients who feel anxious", "a familiar team in the heart of Westport"];
---
<section id="care" class="details-section" aria-labelledby="care-title" data-section="details">
  <div class="details-photo"><Image src={photos.office} alt="Natural light fills a treatment room at our Westport office" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" /></div>
  <div class="section-copy"><h2 id="care-title">we make time<br />for <strong>the details.</strong></h2><p>Good care starts with listening. We want you to feel comfortable with the people looking after you and confident about your next step.</p><ul class="care-checklist">{details.map(detail => <li><Icon name="check" /><span>{detail}</span></li>)}</ul></div>
</section>
