---
import { Image } from "astro:assets";
import { technology } from "../lib/homepage";
import ReviewNote from "./ReviewNote.astro";
const { reviewMode = false } = Astro.props;
---
<section class="technology-section section-space" id="technology" aria-labelledby="technology-title" data-section="technology"><div class="shell">
  <h2 class="section-heading" id="technology-title">A Closer Look<br /><strong>At Your Dental Health.</strong></h2>
  <div class="technology-grid">{technology.map(item => <article class="technology-card"><div class="technology-photo"><Image src={item.image} alt={item.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" /></div><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  <ReviewNote show={reviewMode}>These are still general practice photos. Pam’s equipment photos are pending, including the 3D printer and a description of its use. One technology card will be replaced when that material arrives.</ReviewNote>
</div></section>
