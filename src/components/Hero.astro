---
import { Image } from "astro:assets";
import heroImage from "../assets/hero-care.jpg";
import { site } from "../lib/site";
import Icon from "./Icon.astro";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-rule"></span>Your dentist in Westport, Kansas City</p>
    <h1 id="hero-title">One home for<br /><strong>every smile.</strong></h1>
    <p class="hero-description">Everyday care. Life-changing possibilities. A team that takes the time to know you.</p>
    <div class="hero-actions">
      <a href={site.bookingUrl} class="button button-navy">Book your first visit <Icon /></a>
      <a href="#services" class="text-link">Explore our care <Icon /></a>
    </div>
    <div class="hero-note"><span class="status-dot"></span>A warm welcome for new patients</div>
  </div>
  <div class="hero-visual">
    <div class="hero-photo-wrap">
      <Image src={heroImage} alt="The Cosmetic & Implant Dentistry Westport team together at the practice" loading="eager" fetchpriority="high" widths={[640, 960, 1400]} sizes="(min-width: 900px) 54vw, 100vw" class="hero-photo" />
      <span class="photo-corner" aria-hidden="true"></span>
    </div>
    <div class="hero-caption"><span>Your neighborhood.<br /><strong>Your dental home.</strong></span><a href="#care" aria-label="Discover our approach"><Icon class="arrow-down" /></a></div>
  </div>
</section>
<div class="care-bar" aria-label="Our care at a glance">
  <div class="shell care-bar-inner">
    <span class="care-bar-label">A lifetime of care,<br /><strong>all in one place.</strong></span>
    <a href="#general-care">General dentistry <Icon /></a>
    <a href="#cosmetic-care">Cosmetic dentistry <Icon /></a>
    <a href="#restorative-care">Dental implants <Icon /></a>
    <a href={site.phoneUrl}>Need urgent care? <Icon name="phone" /></a>
  </div>
</div>
