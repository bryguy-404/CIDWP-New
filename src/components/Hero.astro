---
import { Image } from "astro:assets";
import heroImage from "../assets/hero-care.jpg";
import { site } from "../lib/site";

const categories = ["General", "Cosmetic", "Implants", "Emergency"];
---

<section class="hero-frame relative isolate flex items-center overflow-hidden">
  <Image
    src={heroImage}
    alt="Dental professional providing attentive care at the Westport practice"
    loading="eager"
    fetchpriority="high"
    widths={[900, 1400, 1800]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />
  <div class="hero-wash absolute inset-0 -z-10"></div>

  <div class="shell pb-12 pt-32 lg:pt-44">
    <div class="max-w-4xl">
      <div
        class="mb-7 flex items-center gap-3 text-xs font-bold uppercase tracking-[.22em] text-teal"
      >
        <span class="h-px w-10 bg-gold"></span>Care for every stage
      </div>

      <h1 class="max-w-4xl text-[clamp(3.25rem,7.4vw,6.7rem)] font-light leading-[.89] tracking-[-.055em]">
        One home for<br /><span class="font-extrabold">every smile.</span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-7 text-navy/80 sm:text-lg">
        From preventive visits and urgent needs to veneers, dental implants, and full-mouth
        restoration—find thoughtful, full-service care in Westport.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#services"
          class="bg-aqua px-7 py-4 text-center text-sm font-extrabold transition hover:bg-teal hover:text-white"
          >Explore Services</a
        >
        <a
          href={site.contactUrl}
          class="border border-navy bg-ivory/90 px-7 py-4 text-center text-sm font-extrabold transition hover:bg-navy hover:text-white"
          >Contact Us</a
        >
      </div>

      <div
        class="mt-9 inline-flex flex-wrap gap-x-5 gap-y-2 border-l-2 border-gold bg-white/85 px-5 py-4 text-xs font-bold uppercase tracking-[.12em] shadow-sm backdrop-blur"
      >
        {categories.map((category) => <span>{category}</span>)}
      </div>
    </div>
  </div>
</section>
