---
import { Image } from "astro:assets";
import { photos } from "../lib/homepage";
import { site } from "../lib/site";
import ActionPair from "./ActionPair.astro";
---
<section class="hero" aria-labelledby="hero-title" data-section="hero">
  <div class="hero-media">
    <Image src={photos.hero} alt="The Cosmetic & Implant Dentistry Westport team at the practice" widths={[750, 1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
    {site.heroVideoUrl && <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src={site.heroVideoUrl} type="video/mp4" /></video>}
  </div>
  <div class="hero-shade"></div>
  <div class="shell hero-content">
    <div class="hero-copy">
      <p class="hero-location">Your Dentist In Westport, Kansas City</p>
      <h1 id="hero-title">Feel At Home<br /><strong>In Our Care.</strong></h1>
      <p class="hero-description">Everyday care. Caring Experience. A team that takes the time to get to know you.</p>
    </div>
    <ActionPair light />
  </div>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  if (video) {
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const update = () => { if (reducedMotion.matches) video.pause(); else video.play().catch(() => {}); };
    reducedMotion.addEventListener("change", update); update();
  }
</script>
