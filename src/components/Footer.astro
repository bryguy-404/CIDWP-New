---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { site, serviceLinks } from "../lib/site";
import Icon from "./Icon.astro";
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-brand"><a href="/" aria-label={`${site.name} home`}><Image src={logo} alt={site.name} widths={[230, 460]} sizes="230px" class="footer-logo" /></a><p>Personal care.<br />For a lifetime of smiles.</p></div>
      <div><h2 class="small-label">Find your care</h2><ul><li><a href={serviceLinks.general}>General dentistry</a></li><li><a href={serviceLinks.veneers}>Veneers &amp; cosmetic care</a></li><li><a href={serviceLinks.implants}>Dental implants</a></li><li><a href={serviceLinks.emergency}>Emergency dentistry</a></li><li><a href={serviceLinks.sedation}>Sedation options</a></li></ul></div>
      <div><h2 class="small-label">Make yourself at home</h2><ul><li><a href={site.doctorsUrl}>Meet your dentist</a></li><li><a href="#comfort">Your experience</a></li><li><a href={site.smileClubUrl}>Smile Club</a></li><li><a href="#questions">Common questions</a></li><li><a href={site.reviewsUrl} target="_blank" rel="noopener noreferrer">Patient reviews</a></li></ul></div>
      <div class="footer-visit"><h2 class="small-label">Visit us in Westport</h2><address>{site.address}<br />{site.city}</address><a href={site.directionsUrl} target="_blank" rel="noopener noreferrer" class="text-link">Get directions <Icon /></a><a href={site.phoneUrl} class="footer-phone">{site.phone}</a><a href={site.contactUrl}>Contact our team <Icon /></a></div>
    </div>
    <div class="footer-bottom"><p>© {new Date().getFullYear()} {site.name}</p><a href="#main">Back to top <Icon class="arrow-up" /></a></div>
  </div>
</footer>
<div class="mobile-booking-bar"><a href={site.phoneUrl}><Icon name="phone" />Call the practice</a><a href={site.bookingUrl}>Book a visit <Icon /></a></div>
