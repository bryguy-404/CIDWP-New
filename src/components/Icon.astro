---
interface Props {
  name?: "arrow" | "phone" | "pin" | "plus" | "check";
  class?: string;
}
const { name = "arrow", class: className } = Astro.props;
---
<svg class:list={["icon", className]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "phone" && <path d="m8 3 3 5-3 3c1 2 3 4 5 5l3-3 5 3c0 3-2 5-4 5C10 21 3 14 3 7c0-2 2-4 5-4Z" />}
  {name === "pin" && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === "plus" && <path d="M5 12h14M12 5v14" />}
  {name === "check" && <path d="m5 12 4 4L19 6" />}
</svg>
