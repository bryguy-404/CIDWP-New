---
interface Props {
  name?: "arrow" | "phone" | "pin" | "plus" | "check" | "menu" | "chevron" | "close" | "instagram" | "facebook" | "quote";
  class?: string;
}
const { name = "arrow", class: className } = Astro.props;
---
<svg class:list={["icon", className]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "phone" && <path d="m8 3 3 5-3 3c1 2 3 4 5 5l3-3 5 3c0 3-2 5-4 5C10 21 3 14 3 7c0-2 2-4 5-4Z" />}
  {name === "pin" && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === "plus" && <path d="M5 12h14M12 5v14" />}
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {name === "menu" && <path d="M3 7h18M3 17h18" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "close" && <path d="m6 6 12 12M6 18 18 6" />}
  {name === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" /></>}
  {name === "facebook" && <path d="M14 21v-8h3l.5-4H14V7c0-1.5.5-2 2-2h2V2h-3c-3 0-5 2-5 5v2H7v4h3v8" />}
  {name === "quote" && <><path d="M4 13h5v7H2v-6c0-5 2-8 7-10v4c-3 1-5 3-5 5ZM17 13h5v7h-7v-6c0-5 2-8 7-10v4c-3 1-5 3-5 5Z" fill="currentColor" stroke="none" /></>}
</svg>
