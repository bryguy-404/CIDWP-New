---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
interface Props { light?: boolean; class?: string }
const { light = false, class: className } = Astro.props;
---
<div class:list={["action-pair", className]}>
  <a class="button button-brand" href={site.phoneUrl}><Icon name="phone" /><span>{site.textingEnabled ? "Call Or Text" : "Call"} {site.phone}</span></a>
  <a class:list={["button", light ? "button-white" : "button-outline"]} href={site.bookingUrl}>Schedule Now <Icon /></a>
</div>
