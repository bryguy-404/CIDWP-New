---
import { Image } from "astro:assets";
import { gallery, teamPortraits } from "../lib/homepage";
import { site } from "../lib/site";
import Icon from "./Icon.astro";
import ReviewNote from "./ReviewNote.astro";
const { reviewMode = false } = Astro.props;
---
<section class="comfort-section section-space" id="comfort" aria-labelledby="comfort-title" data-section="comfort">
  <div class="shell">
    <div class="comfort-intro"><h2 id="comfort-title">Make Yourself<br /><strong>Comfortable.</strong></h2><p>Get to know the people and the place before you arrive. At our Westport office, we make room for questions, take time to listen, and help you feel more at ease with your care.</p></div>
    <div class="office-gallery">
      {gallery.map((photo, index) => <button class="gallery-photo" type="button" data-photo-src={photo.image.src} data-photo-alt={photo.alt} aria-label={"View photo: " + photo.alt}><Image src={photo.image} alt={photo.alt} widths={[450, 800, 1200]} sizes={index === 0 ? "(min-width: 900px) 48vw, 100vw" : "(min-width: 900px) 24vw, 50vw"} loading="lazy" /><span aria-hidden="true"><Icon name="plus" /></span></button>)}
      {reviewMode && Array.from({length: 6}, (_, index) => <div class="asset-placeholder gallery-placeholder"><span class="placeholder-symbol" aria-hidden="true">+</span><strong>Office Photo {index + 5}</strong><small>client photo requested</small></div>)}
    </div>
    <ReviewNote show={reviewMode}>Four existing practice photos are available. Six additional office and amenity photos are reserved here to match the requested gallery.</ReviewNote>
    <div class="team-portraits">{teamPortraits.map(person => <figure><Image src={person.image} alt={person.name + ", " + person.role} widths={[300, 500]} sizes="(min-width: 900px) 20vw, 44vw" loading="lazy" /><figcaption><strong>{person.name}</strong><span>{person.role}</span></figcaption></figure>)}</div>
    <div class="section-action"><a class="button button-outline" href={site.teamUrl}>Get To Know Our Team <Icon /></a></div>
  </div>
</section>
<dialog class="photo-dialog" id="photoDialog" aria-label="Practice photo">
  <button class="dialog-close" type="button" aria-label="Close photo"><Icon name="close" /></button>
  <img alt="" width="1400" height="1000" />
  <p class="photo-caption"></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#photoDialog");
  const image = dialog?.querySelector("img");
  const caption = dialog?.querySelector(".photo-caption");
  if (dialog && image && caption) {
    document.querySelectorAll<HTMLButtonElement>("[data-photo-src]").forEach(button => {
      button.addEventListener("click", () => {
        image.src = button.dataset.photoSrc || "";
        image.alt = button.dataset.photoAlt || "";
        caption.textContent = image.alt;
        dialog.showModal();
      });
    });
    dialog.querySelector(".dialog-close")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
  }
</script>
