---
import { Image } from "astro:assets";
import team from "../assets/team-member.jpg";
import { site, serviceLinks } from "../lib/site";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
const details = [
  { number: "01", title: "Come as you are.", body: "It’s okay if it’s been a while. Tell us what’s on your mind, and we’ll work through the next step together." },
  { number: "02", title: "Feel informed, never rushed.", body: "Understand your options, ask your questions, and feel involved in the decisions about your care." },
  { number: "03", title: "A little extra reassurance.", body: "Nervous about a visit? Talk with our team about your concerns and the sedation options available." },
];
---
<section id="comfort" class="comfort-section section-space" aria-labelledby="comfort-title">
  <div class="shell">
    <div class="section-intro">
      <div><SectionHeading id="comfort-title" lines={["Feel more at ease", "in the dentist’s chair."]} /></div>
      <p class="body-copy">Good dentistry is about more than teeth. It’s about feeling welcome, being heard, and knowing the people looking after you.</p>
    </div>
    <div class="comfort-grid">
      <figure class="comfort-photo" data-reveal>
        <Image src={team} alt="Our Westport dental team sharing a lighthearted moment together" loading="lazy" widths={[600, 960, 1400]} sizes="(min-width: 900px) 55vw, 100vw" />
        <figcaption>Get to know the people who’ll welcome you and care for you.</figcaption>
      </figure>
      <div class="comfort-details">
        {details.map((item) => <div class="comfort-detail"><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div>)}
        <a href={serviceLinks.sedation} class="text-link">Discover comfort options <Icon /></a>
      </div>
    </div>
    <div class="membership-band">
      <div><p class="small-label">Another way to plan for your care</p><h3>Ask us about care without insurance.</h3><p>Explore the practice’s Smile Club and ask our team about your next steps.</p></div>
      <a href={site.smileClubUrl} class="button button-outline">Explore Smile Club <Icon /></a>
    </div>
  </div>
</section>
